# ==============================================================================
# CUPID AI DATING APP - BACKEND ENVIRONMENT CONFIGURATION (SAMPLE)
# ==============================================================================
# Copy this file to '.env' and fill in the necessary credentials:
# cp .env.example .env
# ==============================================================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# DATABASE CONNECTION (PostgreSQL 16)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Default docker-compose runs PostgreSQL on port 5433
DATABASE_URL="postgresql://cupid_user:cupid_password_2026@localhost:5433/cupid_dating_db?schema=public"

# JWT TOKEN SECRETS & EXPIRATION
JWT_ACCESS_SECRET="cupid_ai_jwt_access_secret_super_secure_key_2026"
JWT_REFRESH_SECRET="cupid_ai_jwt_refresh_secret_super_secure_key_2026"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# GOOGLE GEMINI AI (Free Tier API Key from Google AI Studio)
# Leave empty to automatically use the internal Rule-based Fallback Engine
GEMINI_API_KEY=""

# RESEND API (https://resend.com - Optional for real email dispatch)
RESEND_API_KEY=""

# EMAIL SERVICE (Gmail SMTP / Nodemailer fallback)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Cupid AI Dating <onboarding@resend.dev>"

# GOOGLE AUTHENTICATION (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID="939451413582-kqvgj6lhn10htesi1r9rrb4pthfrqk4q.apps.googleusercontent.com"

# DEV DEMO BYPASS
# When set to true, OTP '123456' is accepted for fast grading and testing without checking emails
ENABLE_DEV_OTP_BYPASS=true
DEV_OTP_CODE="123456"
