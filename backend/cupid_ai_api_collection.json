            "url": {
              "raw": "{{baseUrl}}/ai/icebreaker",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "icebreaker"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Media Upload",
      "item": [
        {
          "name": "Upload Image (Base64)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": \"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD...\",\n  \"type\": \"avatar\"\n}"
